{
  "name": "inksign",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm -C apps/web dev",
    "pack:web": "pnpm -C apps/web build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-web.ps1",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.8"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.0"
  }
}
