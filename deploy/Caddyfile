# Public entry point. Caddy obtains and renews the certificate automatically
# (DNS must point at this host and ports 80/443 must be reachable). The domain comes from SITE_DOMAIN.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy web:8080
}
