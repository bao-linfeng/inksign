{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "pnpm-workspace.yaml rejects versions younger than 24 h (minimumReleaseAge: 1440), so Renovate waits as long before proposing them; strict internal checks keep the PR closed until then."
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separateMultipleMajorReleases"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "ignorePaths": ["**/node_modules/**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "dev dependencies (non-major)"
    },
    {
      "matchPackageNames": [
        "vue",
        "vue-router",
        "@vue/**",
        "vue-tsc",
        "vue-i18n",
        "pinia",
        "@vitejs/plugin-vue"
      ],
      "groupName": "Vue"
    },
    {
      "matchPackageNames": ["vite", "vitest", "@vitest/**"],
      "groupName": "Vite and Vitest"
    },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
      "groupName": "Tailwind CSS"
    },
    {
      "description": [
        "PDF parsing and writing handle untrusted files: review these updates together and promptly."
      ],
      "matchPackageNames": ["pdfjs-dist", "@cantoo/pdf-lib"],
      "groupName": "PDF libraries",
      "schedule": ["at any time"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
